# ==============================================================================
# Gemini CLI - Obsidian Vault 스캔 예외 설정 (.geminiignore)
# ==============================================================================
# 이 파일은 AI 에이전트(Gemini CLI)가 파일 목록을 스캔하고 내용을 분석할 때
# 불필요하거나 무거운 리소스를 스캔하여 발생하는 '토큰 초과 오류'를 방지합니다.
# 
# ※ 주의: 옵시디언 앱 내부의 동작(이미지 링크, 노트 작성 등)에는 영향을 주지 않습니다.
# ==============================================================================

# 1. 옵시디언 캐시 및 시스템 파일
.obsidian/
.trash/

# 2. 대용량 이미지 및 미디어 폴더 전체 예외
_attachments/
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
*.webp
*.mp4
*.mov
*.mp3
*.wav

# 3. 바이너리 문서 및 압축 파일
*.zip
*.tar
*.gz
*.rar
*.7z
*.pdf
*.docx
*.xlsx
*.pptx

# 4. 개발 캐시 및 버전 관리
.git/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
